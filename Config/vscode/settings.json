{
    // Minimal UI
    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "hidden",
    "editor.minimap.enabled": false,
    "window.menuBarVisibility": "toggle",
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "workbench.navigationControl.enabled": false,
    "editor.wordWrap": "on",
    "editor.renderLineHighlight": "all",
    "editor.roundedSelection": false,
    "editor.stickyScroll.enabled": false,
    // Zen Editor Settings
    "editor.cursorBlinking": "solid",
    "editor.formatOnSave": true,
    // Jupyter & Python
    "jupyter.alwaysTrustNotebooks": true,
    "python.terminal.activateEnvironment": true,
    // Settings General
    "telemetry.telemetryLevel": "off",
    "editor.tabSize": 2,
    // UI
    "window.zoomLevel": 1,
    "window.titleBarStyle": "native",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontSize": 15,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "workbench.colorTheme": "Tokyo Night",
    "workbench.colorCustomizations": {
        "[Tokyo Night]": {
            "sideBar.background": "#1A1B26",
            "sideBar.border": "#1A1B26",
            "editorGroup.border": "#1A1B26",
            "panel.background": "#1A1B26",
            "panel.border": "#1A1B26",
            "tab.activeBackground": "#1A1B26",
            "tab.inactiveBackground": "#1A1B26",
            "tab.border": "#1A1B26",
            "tab.activeBorderTop": "#1A1B26",
            "tab.selectedBackground": "#1A1B26",
            "toolbar.activeBackground": "#1A1B26",
            "statusBar.background": "#1A1B26",
            "statusBar.border": "#1A1B26",
            "titleBar.activeBackground": "#1A1B26",
            "scrollbarSlider.background": "#1A1B26",
            "scrollbarSlider.activeBackground": "#1A1B26",
            "scrollbarSlider.hoverBackground": "#1A1B26",
            "editorWidget.border": "#1A1B26",
            "scrollbar.shadow": "#00000000",
            "editorGroupHeader.tabsBackground": "#1A1B26",
            "editorGroupHeader.tabsBorder": "#1A1B26",
            "editorGroupHeader.border": "#1A1B26",
            "notebook.cellBorderColor": "#1A1B26",
        }
    },
    "workbench.iconTheme": "charmed-icons",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "notebook.lineNumbers": "on",
    "breadcrumbs.enabled": false,
    "git.confirmSync": false,
    "chat.viewSessions.orientation": "stacked",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape"
        }
    }
}